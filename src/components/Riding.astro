---
// 趣味：バイク。写真＋メーター＋ツーリング記録＋ガレージ。
// モーショングラフィックは控えめに、ブロックの下端を小さなバイクが走り抜けるだけ。
import { Image } from "astro:assets";
import { bike, bikePhotos } from "../data/profile";
import { colorAt } from "../data/palette";

const { bikes, stats, routes } = bike;

// メーターの最大値：総走行距離を 1 万 km 単位で切り上げ
const maxKm = Math.max(10000, Math.ceil(stats.totalKm / 10000) * 10000);
const ratio = Math.min(1, stats.totalKm / maxKm);

// メーター：中心 (110,118)、半径 86、左下(150°)から右下(390°)まで 240° の円弧
const G = { cx: 110, cy: 118, r: 86, start: 150, sweep: 240 };
const polar = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [G.cx + r * Math.cos(a), G.cy + r * Math.sin(a)];
};
const [ax, ay] = polar(G.start, G.r);
const [bx, by] = polar(G.start + G.sweep, G.r);
const arc = `M${ax} ${ay} A${G.r} ${G.r} 0 1 1 ${bx} ${by}`;
const ticks = Array.from({ length: 21 }, (_, i) => {
  const deg = G.start + (G.sweep * i) / 20;
  const major = i % 4 === 0;
  const [x1, y1] = polar(deg, G.r - 12);
  const [x2, y2] = polar(deg, G.r - (major ? 24 : 18));
  const [lx, ly] = polar(deg, G.r - 36);
  return { x1, y1, x2, y2, major, lx, ly, label: `${Math.round(((maxKm / 20) * i) / 1000)}k` };
});

const maxRoute = Math.max(1, ...routes.map((r) => r.km));
---

<div class="riding" data-anim-scope>
  <p class="lead mono">// riding — バイク</p>

  {
    bikePhotos.length > 0 && (
      <div class="bike-photos">
        {bikePhotos.map((p, i) => (
          <figure class="bike-photo" data-reveal style={`--c: ${colorAt(i + 1)}`}>
            <Image
              src={p.image}
              alt={p.caption || "バイクの写真"}
              widths={[480, 800, 1200]}
              sizes="(max-width: 760px) 100vw, 33vw"
              loading="lazy"
            />
            {p.caption && <figcaption>{p.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }

  <div class="ride-grid">
    <!-- ================================================= meter -->
    <div class="gauge card" data-reveal>
      <svg viewBox="0 0 220 200" aria-hidden="true">
        <defs>
          <linearGradient id="bk-gauge" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" style="stop-color: var(--mint)"></stop>
            <stop offset="0.5" style="stop-color: var(--cyan)"></stop>
            <stop offset="1" style="stop-color: var(--pink)"></stop>
          </linearGradient>
        </defs>
        <path d={arc} fill="none" style="stroke: var(--line)" stroke-width="10" stroke-linecap="round"></path>
        <path
          d={arc}
          fill="none"
          stroke="url(#bk-gauge)"
          stroke-width="10"
          stroke-linecap="round"
          pathLength="1"
          stroke-dasharray="1"
          stroke-dashoffset={1 - ratio}
          data-gauge-arc
          data-ratio={ratio}></path>
        {
          ticks.map((t) => (
            <>
              <line
                x1={t.x1}
                y1={t.y1}
                x2={t.x2}
                y2={t.y2}
                style={`stroke: var(${t.major ? "--ink" : "--ink-3"})`}
                stroke-width={t.major ? 2 : 1}
              />
              {t.major && (
                <text x={t.lx} y={t.ly} class="tick-label" text-anchor="middle" dominant-baseline="middle">
                  {t.label}
                </text>
              )}
            </>
          ))
        }
        <g
          data-gauge-needle
          data-angle={G.start + G.sweep * ratio}
          transform={`rotate(${G.start + G.sweep * ratio} ${G.cx} ${G.cy})`}
        >
          <line
            x1={G.cx - 10}
            y1={G.cy}
            x2={G.cx + G.r - 20}
            y2={G.cy}
            style="stroke: var(--pink)"
            stroke-width="3"
            stroke-linecap="round"></line>
        </g>
        <circle cx={G.cx} cy={G.cy} r="7" style="fill: var(--ink)"></circle>
      </svg>
      <p class="odo">
        <span class="odo-num" data-count={stats.totalKm}>{stats.totalKm.toLocaleString("en-US")}</span>
        <span class="odo-unit mono">km</span>
      </p>
      <p class="meter-label mono">total distance</p>
    </div>

    <!-- ================================================= routes -->
    <div>
      <h3 class="sub mono">// favorite routes</h3>
      <ol class="routes">
        {
          routes.map((r, i) => (
            <li class="route" data-reveal style={`--c: ${colorAt(i + 1)}`}>
              <div class="route-head">
                <span class="route-name">{r.name}</span>
                <span class="route-area">{r.area}</span>
                <span class="route-km mono">{r.km} km</span>
              </div>
              <div class="route-bar">
                <span data-route-bar style={`width: ${(r.km / maxRoute) * 100}%`} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- ================================================= garage -->
  <h3 class="sub mono garage-title">// garage</h3>
  <ul class="bikes">
    {
      bikes.map((b, i) => (
        <li class="bike card" data-reveal style={`--c: ${colorAt(i + 2)}`}>
          <p class="bike-meta mono">
            {b.year}
            {b.cc && <> · {b.cc}cc</>}
          </p>
          <p class="bike-name">
            <span class="bike-maker">{b.maker}</span> {b.name}
          </p>
          {b.note && <p class="bike-note">{b.note}</p>}
        </li>
      ))
    }
  </ul>

  <!-- ================================================= ブロックの下端を走る小さなバイク -->
  <div class="mini-road" aria-hidden="true">
    <div class="mini-track">
      <div class="mini-bike">
        <span class="mini-puffs"><i></i><i></i><i></i></span>
        <svg viewBox="0 0 400 240">
          <defs>
            <!-- 愛車に合わせて黒いタンク -->
            <linearGradient id="mini-tank" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#4a5a78"></stop>
              <stop offset="0.5" stop-color="#1a2438"></stop>
              <stop offset="1" stop-color="#0b1b2b"></stop>
            </linearGradient>
          </defs>
          <!-- アメリカン（クルーザー）：長いホイールベース・寝かせたフォーク・低いシート -->
          <g fill="none" stroke="#0b1b2b" stroke-width="8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M29 170 A52 52 0 0 1 113 140"></path>
            <path d="M295 145 A50 50 0 0 1 355 137"></path>
            <path d="M80 180 L170 165"></path>
            <path d="M120 128 L105 172" stroke="#8fa2c4" stroke-width="7"></path>
            <path d="M150 122 L200 104 L272 88"></path>
            <path d="M272 92 L238 170 L170 165"></path>
            <path d="M272 84 L330 180" stroke="#8fa2c4" stroke-width="10"></path>
            <path d="M266 78 L256 54 L234 58"></path>
            <path d="M226 172 C200 196 130 198 62 194" stroke="#8fa2c4"></path>
            <path d="M262 170 L282 170"></path>
          </g>
          <!-- V ツイン風のエンジン -->
          <g fill="#2a3650">
            <rect x="180" y="138" width="58" height="34" rx="8"></rect>
            <path d="M212 142 L236 112 L250 122 L228 150 Z"></path>
            <path d="M196 142 L184 110 L200 104 L212 138 Z"></path>
          </g>
          <path d="M62 188 L38 192 L40 203 L64 200 Z" fill="#c4d0e0"></path>
          <path d="M196 100 C204 84 252 80 270 90 L268 98 C246 104 214 108 198 110 Z" fill="url(#mini-tank)"></path>
          <path d="M106 122 C124 112 158 114 182 116 L198 108 L201 114 L186 127 C160 129 132 129 108 131 Z" fill="#0b1b2b"></path>
          <circle cx="292" cy="96" r="11" fill="#fff1c2" stroke="#0b1b2b" stroke-width="5"></circle>
          {
            [80, 330].map((cx, i) => (
              <g class="mini-wheel">
                <circle cx={cx} cy="180" r="40" fill="none" stroke="#0b1b2b" stroke-width="15" />
                <circle cx={cx} cy="180" r="25" fill="none" style={`stroke: var(${i ? "--pink" : "--cyan"})`} stroke-width="4" />
                <path
                  d={`M${cx - 25} 180 H${cx + 25} M${cx} 155 V205`}
                  stroke="#8fa2c4"
                  stroke-width="4"
                />
                <circle cx={cx} cy="180" r="6" fill="#0b1b2b" />
              </g>
            ))
          }
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .riding {
    position: relative;
    margin-top: clamp(96px, 12vw, 160px);
  }

  .lead {
    margin: 0 0 28px;
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  /* ---------- photos */
  .bike-photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 14px;
    margin-bottom: 40px;
  }

  .bike-photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .bike-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .bike-photo:hover img {
    scale: 1.05;
  }

  .bike-photo figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 3px 10px;
    font-family: var(--font-jp);
    font-size: 0.8rem;
    color: #fff;
    background: rgba(11, 27, 43, 0.6);
    border-radius: 999px;
  }

  /* ---------- meter + routes */
  .ride-grid {
    display: grid;
    grid-template-columns: minmax(240px, 320px) 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  .gauge {
    padding: 18px 20px 20px;
    text-align: center;
  }

  .gauge svg {
    display: block;
    width: 100%;
    max-width: 240px;
    margin: 0 auto -28px;
    overflow: visible;
  }

  .tick-label {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--ink-3);
  }

  .odo {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    margin: 0;
  }

  .odo-num {
    font-size: clamp(1.9rem, 3.4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .odo-unit {
    color: var(--ink-3);
  }

  .meter-label {
    margin: 2px 0 0;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .sub {
    margin: 0 0 16px;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--ink-3);
  }

  .routes,
  .bikes {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .route-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 8px;
    font-family: var(--font-jp);
  }

  .route-name {
    font-weight: 500;
  }

  .route-area {
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .route-km {
    margin-left: auto;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--c) 72%, var(--ink));
  }

  .route-bar {
    height: 8px;
    overflow: hidden;
    background: var(--line);
    border-radius: 999px;
  }

  .route-bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 40%, #fff), var(--c));
    border-radius: inherit;
    transform-origin: left;
  }

  /* ---------- garage */
  .garage-title {
    margin-top: 48px;
  }

  .bikes {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .bike {
    position: relative;
    padding: 16px 18px 16px 22px;
    overflow: hidden;
  }

  .bike::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--c);
  }

  .bike-meta {
    margin: 0;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--c) 72%, var(--ink));
  }

  .bike-name {
    margin: 2px 0 0;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .bike-maker {
    font-weight: 500;
    color: var(--ink-2);
  }

  .bike-note {
    margin: 4px 0 0;
    font-family: var(--font-jp);
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  /* ---------- 下端を走る小さなバイク（CSS アニメーションのみ・transform だけ） */
  .mini-road {
    position: relative;
    height: 44px;
    margin-top: 48px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /* 幅 100% の帯を 0 → 100%+バイク幅 まで動かし、その中のバイクを端から端へ */
  .mini-track {
    position: absolute;
    inset: 0;
    animation: mini-ride 16s linear infinite;
    will-change: transform;
  }

  .mini-bike {
    position: absolute;
    right: 100%;
    bottom: 1px;
    width: 76px;
    aspect-ratio: 400 / 240;
    animation: mini-bob 0.36s ease-in-out infinite alternate;
  }

  .mini-bike svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mini-wheel {
    transform-box: fill-box;
    transform-origin: center;
    animation: mini-spin 0.45s linear infinite;
  }

  .mini-puffs i {
    position: absolute;
    left: 7%;
    bottom: 14%;
    width: 7px;
    aspect-ratio: 1;
    background: #c9d6e8;
    border-radius: 50%;
    opacity: 0;
    animation: mini-puff 0.9s ease-out infinite;
  }

  .mini-puffs i:nth-child(2) {
    animation-delay: 0.3s;
  }

  .mini-puffs i:nth-child(3) {
    animation-delay: 0.6s;
  }

  @keyframes mini-ride {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(100% + 76px));
    }
  }

  @keyframes mini-bob {
    to {
      translate: 0 -1.5px;
    }
  }

  @keyframes mini-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes mini-puff {
    0% {
      opacity: 0.7;
      transform: translate(0, 0) scale(0.6);
    }
    100% {
      opacity: 0;
      transform: translate(-26px, -6px) scale(1.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-track,
    .mini-bike,
    .mini-wheel,
    .mini-puffs i {
      animation: none;
    }

    .mini-track {
      transform: translateX(80%);
    }
  }

  @media (max-width: 760px) {
    .ride-grid {
      grid-template-columns: 1fr;
    }

    .gauge {
      max-width: 360px;
      width: 100%;
      justify-self: center;
    }
  }
</style>
