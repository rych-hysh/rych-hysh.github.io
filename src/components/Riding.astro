---
// 趣味：バイク。ガレージ＋メーター＋写真。
// 小さなバイクは riding 見出しの横で控えめに動かす。
import { Image } from "astro:assets";
import { bike, bikePhotos } from "../data/profile";
import { colorAt } from "../data/palette";

const { bikes, stats, routes } = bike;

// メーターの最大値：総走行距離を 1 万 km 単位で切り上げ
const maxKm = Math.max(10000, Math.ceil(stats.totalKm / 10000) * 10000);
const ratio = Math.min(1, stats.totalKm / maxKm);

// メーター：中心 (110,118)、半径 86、左下(150°)から右下(390°)まで 240° の円弧
const G = { cx: 110, cy: 118, r: 86, start: 150, sweep: 240 };
const polar = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [G.cx + r * Math.cos(a), G.cy + r * Math.sin(a)];
};
const [ax, ay] = polar(G.start, G.r);
const [bx, by] = polar(G.start + G.sweep, G.r);
const arc = `M${ax} ${ay} A${G.r} ${G.r} 0 1 1 ${bx} ${by}`;
const ticks = Array.from({ length: 21 }, (_, i) => {
  const deg = G.start + (G.sweep * i) / 20;
  const major = i % 4 === 0;
  const [x1, y1] = polar(deg, G.r - 12);
  const [x2, y2] = polar(deg, G.r - (major ? 24 : 18));
  const [lx, ly] = polar(deg, G.r - 36);
  return { x1, y1, x2, y2, major, lx, ly, label: `${Math.round(((maxKm / 20) * i) / 1000)}k` };
});

const maxRoute = Math.max(1, ...routes.map((r) => r.km));
---

<div class="riding" data-anim-scope>
  <div class="riding-head">
    <p class="lead mono">// riding — バイク</p>
<div class="mini-road" aria-hidden="true">
    <div class="mini-track">
      <div class="mini-bike">
        <span class="mini-puffs"><i></i><i></i><i></i></span>
        <svg viewBox="0 0 400 240">
          <defs>
            <linearGradient id="mini-tank" x1="0" y1="0" x2="0.4" y2="1">
              <stop offset="0" stop-color="#59616a"></stop>
              <stop offset="0.35" stop-color="#252a30"></stop>
              <stop offset="1" stop-color="#10151b"></stop>
            </linearGradient>
            <linearGradient id="mini-metal" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#626d78"></stop>
              <stop offset="0.45" stop-color="#d4dbe1"></stop>
              <stop offset="1" stop-color="#626d78"></stop>
            </linearGradient>
          </defs>

          <!-- 実車写真をもとに、低いシート・細長いタンク・短いフェンダーの輪郭にする。 -->
          <g fill="none" stroke="#1b222b" stroke-linecap="round" stroke-linejoin="round">
            <path d="M82 177 L166 166 L141 126" stroke-width="10"></path>
            <path d="M138 124 L180 112 L263 99 L243 172 L166 166 L138 124" stroke-width="7"></path>
            <path d="M263 99 L327 177" stroke-width="11" stroke="url(#mini-metal)"></path>
            <path d="M274 110 L327 177" stroke-width="5"></path>
            <path d="M135 126 L111 173" stroke="url(#mini-metal)" stroke-width="10"></path>
            <path d="M130 135 L119 135 M126 143 L115 143 M122 151 L111 151 M118 159 L107 159" stroke-width="4"></path>
            <path d="M46 149 Q79 119 119 140" stroke-width="10"></path>
            <path d="M298 146 Q326 128 351 149" stroke-width="8"></path>
          </g>

          <path d="M145 132 L175 125 L185 145 L169 161 Z" fill="#28313b" stroke="#141c25" stroke-width="3"></path>

          <!-- 直立したエンジンと前側のラジエーター。 -->
          <path d="M191 119 L229 115 L245 146 L236 173 L192 171 L181 149 Z" fill="#303740" stroke="#121820" stroke-width="5"></path>
          <path d="M196 126 L225 122 L232 144 L200 148 Z" fill="#535b64"></path>
          <path d="M199 130 L225 127 M201 137 L228 134" fill="none" stroke="#242b33" stroke-width="3"></path>
          <circle cx="212" cy="157" r="15" fill="#1d252d" stroke="#77818b" stroke-width="3"></circle>
          <path d="M253 116 L266 120 L274 148 L261 153 Z" fill="#252d35" stroke="#68727d" stroke-width="3"></path>
          <path d="M258 126 L268 128 M261 135 L270 137 M263 144 L272 146" stroke="#8b949e" stroke-width="2"></path>

          <!-- 低い黒いサイレンサーと2本のエキゾーストパイプ。 -->
          <path d="M234 137 Q250 154 251 173 Q248 183 230 185 M243 134 Q260 157 260 175 Q256 192 230 192" fill="none" stroke="#8b949e" stroke-width="5"></path>
          <path d="M124 179 L231 178 Q241 183 234 195 L120 198 Z" fill="#161d25" stroke="#4c5661" stroke-width="3"></path>
          <path d="M120 180 L130 181 L127 197 L117 197 Z" fill="url(#mini-metal)"></path>

          <!-- 段差の小さいシートと、上端が緩やかに伸びるタンク。 -->
          <path d="M105 120 Q119 111 144 113 L172 117 L186 107 L194 115 L180 128 L137 126 L107 129 Z" fill="#111820" stroke="#4d5661" stroke-width="3"></path>
          <path d="M177 101 L183 86 Q214 74 247 82 L264 96 L259 109 L223 118 L191 111 Z" fill="url(#mini-tank)" stroke="#151c23" stroke-width="3"></path>
          <path d="M190 89 Q217 81 243 87" fill="none" stroke="#7d858d" stroke-width="2.5"></path>
          <path d="M203 103 L237 99" stroke="#adb4ba" stroke-width="3" opacity="0.7"></path>
          <path d="M263 85 L254 61 L277 57 M265 60 L276 37 M253 62 L239 41" fill="none" stroke="#252e38" stroke-width="6" stroke-linecap="round"></path>
          <ellipse cx="279" cy="33" rx="10" ry="6" fill="#29333f" transform="rotate(-20 279 33)"></ellipse>
          <ellipse cx="235" cy="37" rx="10" ry="6" fill="#29333f" transform="rotate(20 235 37)"></ellipse>
          <circle cx="291" cy="103" r="13" fill="#e3edf1" stroke="#1c252f" stroke-width="6"></circle>
          <path d="M271 104 H279" stroke="#252e38" stroke-width="6"></path>
          <path d="M284 103 H298" stroke="#fff" stroke-width="3"></path>
          <path d="M48 140 L40 146" stroke="#e46b71" stroke-width="6" stroke-linecap="round"></path>

          <!-- 黒いキャストホイール。タイヤとブレーキは固定し、スポークだけを回す。 -->
          {
            [{ cx: 82, r: 39 }, { cx: 327, r: 43 }].map(({ cx, r }) => (
              <>
                <circle cx={cx} cy="177" r={r} fill="none" stroke="#141c25" stroke-width="13" />
                <circle cx={cx} cy="177" r={r - 8} fill="none" stroke="#65717d" stroke-width="3" />
                <circle cx={cx} cy="177" r="19" fill="none" stroke="#a2adb6" stroke-width="4" />
                <g class="mini-wheel" style={`--wheel-x: ${cx}px`}>
                  {[0, 72, 144, 216, 288].map((angle) => (
                    <path d={`M${cx} 177 L${cx + 10} 164 L${cx + r - 9} 166`} fill="none" stroke="#202a35" stroke-width="5" stroke-linecap="round" transform={`rotate(${angle} ${cx} 177)`} />
                  ))}
                </g>
                <circle cx={cx} cy="177" r="6" fill="#344150" />
              </>
            ))
          }
        </svg>
      </div>
    </div>
  </div>
  </div>

  <div class="ride-grid">
    <!-- ================================================= routes -->
    <div class="ride-details">
      {
        routes.length > 0 && (
          <div>
            <h3 class="sub mono">// favorite routes</h3>
            <ol class="routes">
              {routes.map((r, i) => (
                <li class="route" data-reveal style={`--c: ${colorAt(i + 1)}`}>
                  <div class="route-head">
                    <span class="route-name">{r.name}</span>
                    <span class="route-area">{r.area}</span>
                    <span class="route-km mono">{r.km} km</span>
                  </div>
                  <div class="route-bar">
                    <span data-route-bar style={`width: ${(r.km / maxRoute) * 100}%`} />
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )
      }

      <!-- ================================================= garage -->
      <ul class="bikes">
        {
          bikes.map((b) => (
            <li class="bike" data-reveal>
              <p class="bike-maker">{b.maker}</p>
              <h4 class="bike-name">{b.name}</h4>
              <dl class="bike-specs">
                  <div class="bike-spec">
                    <dt>年式</dt>
                    <dd class="mono">{b.year}</dd>
                  </div>
                  {b.cc && (
                    <div class="bike-spec">
                      <dt>排気量</dt>
                      <dd class="mono">{b.cc} cc</dd>
                    </div>
                  )}
              </dl>
              {b.note && <p class="bike-note">{b.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ================================================= meter -->
    <div class="gauge card" data-reveal>
      <svg viewBox="0 0 220 200" aria-hidden="true">
        <defs>
          <linearGradient id="bk-gauge" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" style="stop-color: var(--mint)"></stop>
            <stop offset="0.5" style="stop-color: var(--cyan)"></stop>
            <stop offset="1" style="stop-color: var(--pink)"></stop>
          </linearGradient>
        </defs>
        <path d={arc} fill="none" style="stroke: var(--line)" stroke-width="10" stroke-linecap="round"></path>
        <path
          d={arc}
          fill="none"
          stroke="url(#bk-gauge)"
          stroke-width="10"
          stroke-linecap="round"
          pathLength="1"
          stroke-dasharray="1"
          stroke-dashoffset={1 - ratio}
          data-gauge-arc
          data-ratio={ratio}></path>
        {
          ticks.map((t) => (
            <>
              <line
                x1={t.x1}
                y1={t.y1}
                x2={t.x2}
                y2={t.y2}
                style={`stroke: var(${t.major ? "--ink" : "--ink-3"})`}
                stroke-width={t.major ? 2 : 1}
              />
              {t.major && (
                <text x={t.lx} y={t.ly} class="tick-label" text-anchor="middle" dominant-baseline="middle">
                  {t.label}
                </text>
              )}
            </>
          ))
        }
        <g
          data-gauge-needle
          data-angle={G.start + G.sweep * ratio}
          transform={`rotate(${G.start + G.sweep * ratio} ${G.cx} ${G.cy})`}
        >
          <line
            x1={G.cx - 10}
            y1={G.cy}
            x2={G.cx + G.r - 20}
            y2={G.cy}
            style="stroke: var(--pink)"
            stroke-width="3"
            stroke-linecap="round"></line>
        </g>
        <circle cx={G.cx} cy={G.cy} r="7" style="fill: var(--ink)"></circle>
      </svg>
      <p class="odo">
        <span class="odo-num" data-count={stats.totalKm}>{stats.totalKm.toLocaleString("en-US")}</span>
        <span class="odo-unit mono">km</span>
      </p>
      <p class="meter-label mono">total distance</p>
    </div>
  </div>

  {
    bikePhotos.length > 0 && (
      <div class="bike-photos">
        {bikePhotos.map((p, i) => (
          <figure class="bike-photo" data-reveal style={`--c: ${colorAt(i + 1)}`}>
            <a href={p.image.src} data-photo-open data-photo-alt={p.caption || "バイクの写真"} aria-label={`${p.caption || "バイクの写真"}を拡大`}>
              <Image
                src={p.image}
                alt={p.caption || "バイクの写真"}
                widths={[480, 800, 1200]}
                sizes="(max-width: 760px) 100vw, 50vw"
                loading="lazy"
              />
            </a>
          </figure>
        ))}
      </div>
    )
  }
</div>

<style>
  .riding {
    position: relative;
    margin-top: clamp(96px, 12vw, 160px);
  }

  .riding-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  .lead {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  /* ---------- photos */
  .bike-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 14px;
    margin-top: 40px;
  }

  .bike-photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .bike-photo a {
    display: block;
    height: 100%;
    cursor: zoom-in;
  }

  .bike-photo a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: -3px;
  }

  .bike-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .bike-photo:hover img {
    scale: 1.05;
  }


  /* ---------- meter + routes */
  .ride-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  .gauge {
    padding: 18px 20px 20px;
    text-align: center;
  }

  .gauge svg {
    display: block;
    width: 100%;
    max-width: 240px;
    margin: 0 auto -28px;
    overflow: visible;
  }

  .tick-label {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--ink-3);
  }

  .odo {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    margin: 0;
  }

  .odo-num {
    font-size: clamp(1.9rem, 3.4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .odo-unit {
    color: var(--ink-3);
  }

  .meter-label {
    margin: 2px 0 0;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .sub {
    margin: 0 0 16px;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--ink-3);
  }

  .routes,
  .bikes {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .route-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 8px;
    font-family: var(--font-jp);
  }

  .route-name {
    font-weight: 500;
  }

  .route-area {
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .route-km {
    margin-left: auto;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--c) 72%, var(--ink));
  }

  .route-bar {
    height: 8px;
    overflow: hidden;
    background: var(--line);
    border-radius: 999px;
  }

  .route-bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 40%, #fff), var(--c));
    border-radius: inherit;
    transform-origin: left;
  }

  /* ---------- garage */
  .bikes {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .bike {
    container-type: inline-size;
    min-width: 0;
    padding: 26px 8px 20px;
    border-top: 2px solid var(--ink);
  }

  .bike-maker {
    margin: 0 0 16px;
    color: var(--ink-2);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
  }

  .bike-name {
    margin: 0 0 24px;
    font-size: clamp(1.6rem, 10cqi, 3rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.06em;
    overflow-wrap: anywhere;
  }

  .bike-specs {
    display: flex;
    flex-wrap: wrap;
    row-gap: 12px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin: 0 0 20px;
  }

  .bike-spec {
    position: relative;
    padding-right: 26px;
  }

  .bike-spec + .bike-spec {
    padding-left: 26px;
    border-left: 1px solid var(--line);
  }

  .bike-spec dt {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .bike-spec dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .bike-note {
    margin: 0;
    font-family: var(--font-jp);
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--ink-2);
  }

  /* ---------- riding 見出し横の小さなバイク */
  .mini-road {
    position: relative;
    flex: 0 0 72px;
    height: 40px;
    opacity: 0.75;
  }

  .mini-track {
    position: absolute;
    inset: 0;
  }

  .mini-bike {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 64px;
    aspect-ratio: 400 / 240;
    animation: mini-bob 1.2s ease-in-out infinite alternate;
  }

  .mini-bike svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mini-wheel {
    transform-box: view-box;
    transform-origin: var(--wheel-x) 177px;
    animation: mini-spin 2.4s linear infinite;
  }

  .mini-puffs i {
    position: absolute;
    left: 7%;
    bottom: 14%;
    width: 7px;
    aspect-ratio: 1;
    background: #c9d6e8;
    border-radius: 50%;
    opacity: 0;
    animation: mini-puff 0.9s ease-out infinite;
  }

  .mini-puffs i:nth-child(2) {
    animation-delay: 0.3s;
  }

  .mini-puffs i:nth-child(3) {
    animation-delay: 0.6s;
  }

  @keyframes mini-bob {
    to {
      translate: 0 -1.5px;
    }
  }

  @keyframes mini-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes mini-puff {
    0% {
      opacity: 0.3;
      transform: translate(0, 0) scale(0.6);
    }
    100% {
      opacity: 0;
      transform: translate(-12px, -3px) scale(1.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-track,
    .mini-bike,
    .mini-wheel,
    .mini-puffs i {
      animation: none;
    }

  }

  @media (max-width: 760px) {
    .ride-grid {
      grid-template-columns: 1fr;
    }

    .gauge {
      max-width: 360px;
      width: 100%;
      justify-self: center;
    }
  }

</style>
