---
import { profile } from "../data/profile";

const [first, ...rest] = profile.name.split(" ");
const last = rest.join(" ");
---

<section class="hero" id="top" data-anim-scope>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="blob blob-1" aria-hidden="true"></div>
  <div class="blob blob-2" aria-hidden="true"></div>
  <div class="blob blob-3" aria-hidden="true"></div>
  <div class="blob blob-4" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="hero-kicker mono" data-hero-fade>
      <span class="dot"></span> Hello, world. I'm
    </p>
    <h1 class="hero-title">
      <span class="line" data-split>{first}</span>
      <span class="line grad-text" data-split>{last}</span>
    </h1>
    <p class="hero-role mono" data-hero-fade>
      <span aria-hidden="true">&gt;</span>
      <span class="role-label">{profile.role}</span>
      <span class="role-animation" aria-hidden="true"><span data-typing={profile.role}>{profile.role}</span><span class="caret">▍</span></span>
    </p>
    <p class="hero-tagline">{profile.tagline}</p>
    <nav class="hero-links" aria-label="興味のある内容へ">
      <a class="hero-link hero-link-primary" href="#about">
        自己紹介・経歴 <span aria-hidden="true">↓</span>
      </a>
      <a class="hero-link" href="#hobbies">
        写真・趣味 <span aria-hidden="true">↓</span>
      </a>
      <a class="hero-link" href="/travel/">
        旅の記録 <span aria-hidden="true">→</span>
      </a>
    </nav>
  </div>

  <a href="#about" class="scroll-hint mono" data-hero-fade>
    <span>自己紹介へ</span>
    <span class="scroll-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: 120px 0 112px;
    overflow: hidden;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
    pointer-events: none;
  }

  .blob-1 {
    width: 46vw;
    height: 46vw;
    top: -10vw;
    right: -10vw;
    background: radial-gradient(circle, #8fe9ff, transparent 70%);
  }

  .blob-2 {
    width: 36vw;
    height: 36vw;
    bottom: -12vw;
    left: -8vw;
    background: radial-gradient(circle, #a8f5dc, transparent 70%);
  }

  .blob-3 {
    width: 30vw;
    height: 30vw;
    top: 30%;
    right: 18%;
    background: radial-gradient(circle, #ffb3d4, transparent 70%);
    opacity: 0.45;
  }

  .blob-4 {
    width: 26vw;
    height: 26vw;
    bottom: 4%;
    right: -4vw;
    background: radial-gradient(circle, #ffe08a, transparent 70%);
    opacity: 0.45;
  }

  .blob {
    animation: drift 14s ease-in-out infinite alternate;
  }

  .blob-2 {
    animation-duration: 18s;
  }

  .blob-3 {
    animation-duration: 11s;
    animation-direction: alternate-reverse;
  }

  .blob-4 {
    animation-duration: 16s;
  }

  @keyframes drift {
    to {
      translate: 6vw -4vw;
      scale: 1.15;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  .hero-inner a {
    pointer-events: auto;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 20px;
    padding: 6px 14px;
    font-size: 0.85rem;
    color: var(--ink-2);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 0 rgba(46, 230, 166, 0.6);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(46, 230, 166, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(46, 230, 166, 0);
    }
  }

  .hero-title {
    margin: 0;
    font-size: clamp(3.4rem, 11vw, 8.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.22em;
    margin-bottom: -0.16em;
  }

  /*
   * グラデーション文字は background-clip: text なので、文字の箱の外（y の払いなど）は塗られない。
   * 1 文字ずつの箱を下に広げて、行間は打ち消して変えない。文字は JS で生成されるので :global
   */
  .line :global(.char) {
    padding-bottom: 0.22em;
    margin-bottom: -0.22em;
  }

  .hero-role {
    margin: 28px 0 8px;
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--violet);
  }

  /* 読み上げには全文を一度だけ渡し、タイピング途中の文字列は読ませない。 */
  .role-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero-role > :first-child,
  .caret {
    color: var(--pink);
  }

  .caret {
    margin-left: 2px;
    animation: blink 1s steps(2) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero-tagline {
    max-width: 42ch;
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
    pointer-events: auto;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 48px;
    padding: 10px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-jp);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s, border-color 0.2s;
  }

  .hero-link:hover {
    background: var(--bg-2);
    border-color: var(--ink-2);
  }

  .hero-link-primary {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }

  .hero-link-primary:hover {
    background: var(--ink-2);
  }

  .hero-link:focus-visible,
  .scroll-hint:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 136px;
      padding-bottom: 100px;
    }

    .hero-kicker {
      margin-bottom: 24px;
    }

    .hero-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 24px;
    }

    .hero-link {
      gap: 12px;
      padding-inline: 16px;
    }

    .hero-link-primary {
      grid-column: 1 / -1;
    }
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--ink-2);
    transform: translateX(-50%);
  }

  .scroll-line {
    position: relative;
    width: 1px;
    height: 48px;
    background: var(--line);
    overflow: hidden;
  }

  .scroll-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--cyan);
    animation: drip 1.8s cubic-bezier(0.7, 0, 0.3, 1) infinite;
  }

  @keyframes drip {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob,
    .dot,
    .caret,
    .scroll-line::after {
      animation: none;
    }
  }

  @media (max-width: 640px) and (max-height: 700px) {
    .hero {
      padding-top: 132px;
      padding-bottom: 36px;
    }

    .hero-kicker {
      margin-bottom: 16px;
    }

    .hero-title {
      font-size: 3rem;
    }

    .hero-role {
      margin-top: 16px;
    }

    .hero-tagline {
      font-size: 0.8rem;
    }

    .hero-links {
      margin-top: 16px;
    }

    .scroll-hint {
      display: none;
    }
  }
</style>
