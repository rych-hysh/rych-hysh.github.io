---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { projects } from "../data/profile";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../content/projects/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
);
const byName = new Map(Object.entries(images).map(([path, load]) => [path.split("/").pop()!, load]));
const entries = await Promise.all(projects.map(async (project) => {
  let image: ImageMetadata | undefined;
  if (project.screenshot) {
    const load = byName.get(project.screenshot.file);
    if (!load) {
      throw new Error(`content/projects.yaml の写真 "${project.screenshot.file}" が content/projects/ に見つかりません`);
    }
    image = (await load()).default;
  }
  return { project, image };
}));
---

{entries.length > 0 && (
  <section class="section projects" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head">
        <span class="section-index mono">WORK /</span>
        <h2 class="section-title" id="projects-title"><span class="grad">Projects</span></h2>
      </div>
      <p class="projects-lead">{projects.every((project) => project.sample)
        ? "紹介形式を確認するための架空のサンプルです。実際の作品・実績ではありません。"
        : "個人で開発しているアプリを紹介します。"}</p>
      <div class="project-list">
        {entries.map(({ project, image }) => (
          <article class:list={["card", "project", { "with-image": !!image }]} aria-labelledby={`project-${project.id}`} data-reveal>
            <div class="project-body">
              {project.sample && <p class="sample-label mono">SAMPLE / 架空のアプリ</p>}
              {project.status && <p class="project-status mono">{project.status}</p>}
              <h3 id={`project-${project.id}`} class="project-name">{project.name}</h3>
              <p class="project-summary">{project.summary}</p>
              <dl class="project-details">
                <div><dt>{project.sample ? "担当（記入例）" : "担当"}</dt><dd>{project.role}</dd></div>
                <div><dt>{project.sample ? "特徴（記入例）" : "特徴"}</dt><dd><ul class="project-features">{project.features.map((feature) => <li>{feature}</li>)}</ul></dd></div>
              </dl>
              {project.stack.length > 0 && (
                <ul class="project-stack mono" aria-label={project.sample ? "使用技術の記入例" : "使用技術"}>{project.stack.map((tech) => <li>{tech}</li>)}</ul>
              )}
              {project.links.length > 0 && (
                <ul class="project-links" aria-label={`${project.name}の公開リンク`}>
                  {project.links.map((link) => <li><a href={link.url}>{link.label}<span aria-hidden="true"> ↗</span></a></li>)}
                </ul>
              )}
            </div>
            {image && project.screenshot && (
              <figure class="project-visual">
                <div class="screenshot-frame">
                  <Image src={image} alt={project.screenshot.alt} widths={[480, 800, 1200]}
                    sizes="(max-width: 760px) 90vw, 38vw" loading="lazy" />
                </div>
                {project.screenshot.caption && <figcaption>{project.screenshot.caption}</figcaption>}
              </figure>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .projects {
    --accent: var(--blue);
    --accent-2: var(--violet);
    scroll-margin-top: 88px;
  }

  .projects-lead {
    margin: -16px 0 36px;
    color: var(--ink-2);
    font-family: var(--font-jp);
  }

  .project-list { display: grid; gap: 32px; }
  .project { overflow: hidden; }
  .project.with-image { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  .project-body { min-width: 0; padding: clamp(24px, 4vw, 48px); overflow-wrap: anywhere; }
  .project-status { margin: 0 0 12px; color: var(--ink-2); font-size: 0.8rem; }
  .sample-label { width: fit-content; margin: 0 0 16px; padding: 5px 12px; border: 1px dashed var(--accent); border-radius: 6px; font-size: 0.75rem; color: var(--ink); }
  .project-name { margin: 0 0 16px; font-size: clamp(1.65rem, 3vw, 2.4rem); line-height: 1.3; letter-spacing: -0.03em; }
  .project-summary { margin: 0 0 28px; font-family: var(--font-jp); color: var(--ink-2); line-height: 1.9; white-space: pre-line; }
  .project-details { display: grid; gap: 20px; margin: 0; font-family: var(--font-jp); }
  .project-details dt { margin-bottom: 6px; font-size: 0.8rem; color: var(--ink-2); }
  .project-details dd { margin: 0; font-size: 0.95rem; white-space: pre-line; }
  .project-features { margin: 0; padding-left: 1.2em; }
  .project-features li + li { margin-top: 6px; }
  .project-stack, .project-links { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 28px 0 0; }
  .project-stack li { border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; font-size: 0.75rem; color: var(--ink-2); }
  .project-links { gap: 12px; }
  .project-links a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 10px 16px; border: 1px solid var(--line); border-radius: 10px; font-family: var(--font-jp); font-size: 0.9rem; font-weight: 500; }
  .project-links a:hover { background: var(--bg-2); border-color: var(--accent); }
  .project-links a:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .project-visual { order: -1; display: flex; flex-direction: column; justify-content: center; gap: 16px; min-width: 0; margin: 0; padding: clamp(24px, 4vw, 40px); background: linear-gradient(145deg, var(--bg-2), color-mix(in srgb, var(--violet) 8%, var(--bg))); }
  .screenshot-frame { display: flex; justify-content: center; align-items: center; }
  .screenshot-frame img { width: auto; max-width: 100%; height: auto; max-height: 520px; object-fit: contain; border-radius: 12px; box-shadow: 0 20px 40px -24px var(--ink-2); }
  .project-visual figcaption { color: var(--ink-2); font-family: var(--font-jp); font-size: 0.8rem; text-align: center; overflow-wrap: anywhere; }

  @media (max-width: 760px) {
    .project.with-image { grid-template-columns: minmax(0, 1fr); }
    .project-visual { order: 0; }
    .screenshot-frame img { max-height: 400px; }
  }
</style>
