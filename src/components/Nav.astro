---
import { profile } from "../data/profile";

const links = [
  { href: "/#about", label: "About" },
  { href: "/#skills", label: "Skills" },
  { href: "/#hobbies", label: "Hobbies" },
  { href: "/#travel", label: "Travel" },
  { href: "/#contact", label: "Contact" },
];
---

<div class="progress" aria-hidden="true"><span></span></div>
<header class="nav">
  <a href="/#top" class="logo mono" aria-label={`${profile.name} トップへ`}>
    <span class="logo-mark" aria-hidden="true"></span>{profile.name.split(" ")[0].toLowerCase()}<span class="blink" aria-hidden="true">_</span>
  </a>
  <nav aria-label="メインナビゲーション">
    <ul>
      {links.map((l) => <li><a href={l.href} aria-current={l.href === Astro.url.pathname ? "page" : undefined}>{l.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--rainbow);
    transform-origin: left;
    transform: scaleX(0);
  }

  .nav {
    position: fixed;
    top: 12px;
    left: 50%;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(1200px, calc(100% - 2 * 16px));
    padding: 10px 12px 10px 20px;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--line);
    border-radius: 999px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .logo-mark {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    background: var(--grad);
    box-shadow: 0 0 12px rgba(0, 184, 217, 0.6);
  }

  .blink {
    color: var(--cyan);
    animation: blink 1s steps(2) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--ink-2);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    -webkit-tap-highlight-color: transparent;
    transition:
      text-decoration-color 0.2s,
      color 0.2s;
  }

  nav a[aria-current="page"],
  nav a:active {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  @media (hover: hover) {
    nav a:hover {
      color: var(--ink);
      text-decoration-color: currentColor;
    }
  }

  a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .nav {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 8px;
      border-radius: 24px;
    }

    .logo {
      align-self: flex-start;
      min-height: 44px;
      margin-left: 8px;
      font-size: 0.85rem;
    }

    nav a {
      padding: 6px 2px;
      font-size: 0.75rem;
    }

    ul {
      gap: 0;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blink {
      animation: none;
    }
  }
</style>
