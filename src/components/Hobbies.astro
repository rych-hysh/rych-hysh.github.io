---
import { photos } from "../data/profile";
import PhotoGallery from "./PhotoGallery.astro";
import PhotoLightbox from "./PhotoLightbox.astro";
import Riding from "./Riding.astro";
import Travel from "./Travel.astro";
---

<section class="section hobbies" id="hobbies">
  <div class="container">
    <div class="section-head">
      <span class="section-index">03 /</span>
      <h2 class="section-title">Hobbies <span class="grad">&amp; Travel</span></h2>
    </div>
  </div>

  <PhotoGallery />

  <div id="travel" class:list={["container travel", { "travel-with-photos": photos.length > 0 }]}>
    <p class="lead mono">// travel — 行った場所</p>
    <Travel limit={3} />
  </div>
  <div class="container">
    <Riding />
  </div>
</section>
<PhotoLightbox />

<style>
  .lead {
    margin: 0 0 28px;
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  /* ---------- travel ---------- */
  .travel {
    scroll-margin-top: 140px;
  }

  .travel-with-photos {
    margin-top: clamp(96px, 12vw, 160px);
  }

</style>
