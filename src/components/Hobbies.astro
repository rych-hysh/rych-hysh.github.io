---
import { Image } from "astro:assets";
import { photos, trips } from "../data/profile";
import { colorAt, palette } from "../data/palette";
import Riding from "./Riding.astro";
---

<section class="section hobbies" id="hobbies">
  <div class="container">
    <div class="section-head">
      <span class="section-index">03 /</span>
      <h2 class="section-title">Hobbies <span class="grad">&amp; Travel</span></h2>
    </div>
    <p class="lead mono">// photography — 撮った写真</p>
  </div>

  <div class="gallery" data-gallery>
    <div class="gallery-track" data-gallery-track>
      {
        photos.map((p, i) => (
          <figure class="photo" style={`--c: ${colorAt(i)}`}>
            <div class="photo-frame">
              <Image
                src={p.image}
                alt={p.place ? `${p.title} — ${p.place}` : p.title}
                widths={[480, 800, 1200]}
                sizes="(max-width: 760px) 78vw, 38vw"
                loading="lazy"
                data-parallax
              />
            </div>
            <figcaption>
              <span class="mono idx">{String(i + 1).padStart(2, "0")}</span>
              <span class="ph-title">{p.title}</span>
              <span class="mono ph-place">{p.place}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="container travel">
    <p class="lead mono">// travel — 行った場所</p>
    <div class="travel-grid">
      <div class="globe-wrap" data-reveal data-anim-scope>
        <canvas class="globe" data-globe data-trips={JSON.stringify(trips)} data-colors={JSON.stringify(palette)} aria-label="訪れた場所を示す地球儀"></canvas>
        <span class="globe-label mono" data-globe-label></span>
      </div>
      <ol class="trips">
        {
          trips.map((t, i) => (
            <li class="trip" data-reveal data-trip={i} tabindex="0" style={`--c: ${colorAt(i)}`}>
              <span class="mono trip-no">{String(i + 1).padStart(2, "0")}</span>
              <span class="trip-place">{t.place}</span>
              <span class="trip-region">{t.region !== t.place ? t.region : ""}</span>
              <span class="mono trip-coord">
                {t.lat.toFixed(2)}, {t.lng.toFixed(2)}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
  <div class="container">
    <Riding />
  </div>
</section>

<style>
  .lead {
    margin: 0 0 28px;
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  /* ---------- gallery ---------- */
  .gallery {
    overflow: hidden;
  }

  .gallery-track {
    display: flex;
    gap: clamp(16px, 2.5vw, 32px);
    width: max-content;
    padding: 0 var(--gutter);
  }

  .photo {
    flex-shrink: 0;
    width: clamp(260px, 38vw, 520px);
    margin: 0;
  }

  .photo:nth-child(even) {
    margin-top: clamp(24px, 6vw, 80px);
  }

  .photo-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .photo-frame img {
    width: 100%;
    height: 120%;
    object-fit: cover;
    transition: filter 0.4s;
  }

  .photo:hover img {
    filter: saturate(1.2) brightness(1.05);
  }

  figcaption {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-top: 14px;
  }

  .idx {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--c) 72%, var(--ink));
  }

  .photo-frame {
    box-shadow: 0 30px 60px -35px var(--c);
  }

  .ph-title {
    font-weight: 500;
  }

  .ph-place {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  /* JS が無効 or 狭い画面では横スクロール */
  @media (max-width: 760px) {
    .gallery {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .gallery::-webkit-scrollbar {
      display: none;
    }

    .photo {
      scroll-snap-align: center;
      width: 78vw;
    }
  }

  /* ---------- travel ---------- */
  .travel {
    margin-top: clamp(96px, 12vw, 160px);
  }

  .travel-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .globe-wrap {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1;
    width: 100%;
    max-width: 520px;
    justify-self: center;
  }

  .globe-wrap::after {
    content: "";
    position: absolute;
    inset: 4%;
    z-index: -1;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--cyan), var(--violet), var(--pink), var(--coral), var(--yellow), var(--mint), var(--cyan));
    filter: blur(40px);
    opacity: 0.35;
    animation: spin 18s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .globe-wrap::after {
      animation: none;
    }
  }

  .globe-wrap::before {
    content: "";
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffffff, #dff4fb 50%, #c4e8f5 100%);
    box-shadow:
      0 40px 80px -30px rgba(58, 123, 255, 0.45),
      inset -20px -30px 60px rgba(58, 123, 255, 0.15);
  }

  .globe {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }

  .globe:active {
    cursor: grabbing;
  }

  .globe-label {
    position: absolute;
    left: 50%;
    bottom: 0;
    padding: 4px 12px;
    font-size: 0.8rem;
    color: #fff;
    background: var(--ink);
    border-radius: 999px;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.3s;
    white-space: nowrap;
  }

  .globe-label.show {
    opacity: 1;
  }

  .trips {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .trip {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    grid-template-areas:
      "no place coord"
      "no region coord";
    column-gap: 14px;
    padding: 10px 8px;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    outline: none;
    transition:
      background 0.25s,
      padding 0.25s;
  }

  .trip:hover,
  .trip:focus-visible,
  .trip.active {
    padding-left: 16px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 16%, transparent), transparent);
  }

  .trip-no {
    grid-area: no;
    align-self: center;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--c) 72%, var(--ink));
  }

  .trip-place {
    grid-area: place;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .trip-region {
    grid-area: region;
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .trip-coord {
    grid-area: coord;
    align-self: center;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  /* PC では一覧をスクロールしている間も地球儀を画面に残す */
  @media (min-width: 861px) {
    .travel-grid {
      align-items: start;
    }

    .globe-wrap {
      position: sticky;
      top: max(96px, calc(50vh - 260px));
    }
  }

  @media (max-width: 860px) {
    .travel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
