---
import { profile, career } from "../data/profile";
import { colorAt } from "../data/palette";
---

<section class="section" id="about">
  <div class="container">
    <div class="section-head">
      <span class="section-index">01 /</span>
      <h2 class="section-title">About <span class="grad">&amp; Career</span></h2>
    </div>

    <div class="about-grid">
      <div class="intro">
        <p class="intro-text" data-words>{profile.intro}</p>
        <dl class="meta mono" data-reveal>
          <div><dt>role</dt><dd>{profile.role}</dd></div>
          <div><dt>based</dt><dd>{profile.location}</dd></div>
        </dl>
      </div>

      <ol class="timeline">
        <span class="timeline-track" aria-hidden="true"><span class="timeline-fill"></span></span>
        {
          career.map((c, i) => (
            <li class="tl-item" data-reveal style={`--c: ${colorAt(i * 2)}`}>
              <span class="tl-node" aria-hidden="true" />
              <p class="tl-period mono">{c.period}</p>
              <h3 class="tl-title">{c.title}</h3>
              <p class="tl-org">{c.org}</p>
              <p class="tl-desc">{c.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(40px, 8vw, 120px);
    align-items: start;
  }

  .intro {
    position: sticky;
    top: 120px;
  }

  .intro-text {
    margin: 0 0 32px;
    font-family: var(--font-jp);
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.9;
  }

  .meta {
    display: grid;
    gap: 8px;
    margin: 0;
    font-size: 0.9rem;
  }

  .meta div {
    display: flex;
    gap: 16px;
  }

  .meta dt {
    width: 64px;
    color: var(--ink-3);
  }

  .meta dd {
    margin: 0;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 36px;
    list-style: none;
  }

  .timeline-track {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 7px;
    width: 2px;
    background: var(--line);
    border-radius: 2px;
  }

  .timeline-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--cyan), var(--violet), var(--pink));
    transform-origin: top;
    transform: scaleY(0);
  }

  .tl-item {
    position: relative;
    padding-bottom: 48px;
  }

  .tl-item:last-child {
    padding-bottom: 0;
  }

  .tl-node {
    position: absolute;
    top: 6px;
    left: -36px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--c);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--c) 18%, transparent);
  }

  .tl-period {
    margin: 0 0 4px;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--c) 72%, var(--ink));
  }

  .tl-title {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.3;
  }

  .tl-org {
    margin: 2px 0 10px;
    color: var(--ink-2);
    font-weight: 500;
  }

  .tl-desc {
    margin: 0;
    font-family: var(--font-jp);
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .intro {
      position: static;
    }
  }
</style>
