---

<section class="section contact" id="contact">
  <div class="container">
    <div class="section-head">
      <span class="section-index">04 /</span>
      <h2 class="section-title">Let's <span class="grad">connect</span></h2>
    </div>

    <ul class="socials">
      {
        socials.map((s, i) => (
          <li data-reveal style={`--c: ${colorAt(i)}; --c2: ${colorAt(i + 1)}`}>
            <a
              class="social card"
              href={s.url}
              target={s.url.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener"
              data-magnetic
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={icons[s.icon]} fill="currentColor" />
              </svg>
              <span class="s-label">{s.label}</span>
              <span class="s-handle mono">{s.handle}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <footer class="container footer mono">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <a href="#top">back to top ↑</a>
  </footer>
</section>

<style>
  .contact {
    padding-bottom: 32px;
  }

  .socials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin: 0 0 clamp(96px, 14vw, 160px);
    padding: 0;
    list-style: none;
  }

  .social {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 24px;
    overflow: hidden;
    transition:
      color 0.35s,
      border-color 0.35s;
    isolation: isolate;
  }

  .social::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, var(--c), var(--c2));
    transform: translateY(101%);
    transition: transform 0.45s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .social:hover,
  .social:focus-visible {
    color: #fff;
    border-color: transparent;
  }

  .social:hover::before,
  .social:focus-visible::before {
    transform: translateY(0);
  }

  svg {
    width: 28px;
    height: 28px;
    margin-bottom: 20px;
    color: color-mix(in srgb, var(--c) 72%, var(--ink));
    transition: color 0.35s;
  }

  .social:hover svg,
  .social:focus-visible svg {
    color: #fff;
  }

  .s-label {
    font-size: 1.3rem;
    font-weight: 700;
  }

  .s-handle {
    font-size: 0.8rem;
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    position: absolute;
    top: 20px;
    right: 22px;
    font-size: 1.3rem;
    transition: transform 0.35s;
  }

  .social:hover .arrow {
    transform: translate(3px, -3px) rotate(0deg) scale(1.15);
  }

  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    font-size: 0.8rem;
    color: var(--ink-3);
    border-top: 1px solid var(--line);
  }

  .footer a:hover {
    color: var(--pink);
  }
</style>
