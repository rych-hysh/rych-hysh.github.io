---
// Contact：メールアドレスを主役に（コピーボタン付き）、SNS はアイコンのドックで
import { profile, socials } from "../data/profile";
import { icons } from "../data/icons";
import { colorAt } from "../data/palette";

const mail = socials.find((s) => s.icon === "mail");
const others = socials.filter((s) => s.icon !== "mail");
---

<section class="section contact" id="contact">
  <div class="container">
    <div class="section-head">
      <span class="section-index">04 /</span>
      <h2 class="section-title"><span class="grad">Contact</span></h2>
    </div>

    <div class="cta">
      {
        mail && (
          <div class="cta-mail" data-reveal>
            <p class="cta-kicker mono">// say hello</p>
            <a class="cta-address" href={mail.url}>
              {mail.handle}
            </a>
            <button class="cta-copy mono" type="button" data-copy={mail.handle} aria-label="メールアドレスをコピー">
              copy
            </button>
          </div>
        )
      }

      <ul class="dock" data-reveal>
        {
          others.map((s, i) => (
            <li style={`--c: ${colorAt(i + 1)}`}>
              <a
                class="dock-btn"
                href={s.url}
                target="_blank"
                rel="noopener"
                aria-label={`${s.label}（${s.handle}）`}
                data-magnetic
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={icons[s.icon]} fill="currentColor" />
                </svg>
                <span class="dock-tip mono" aria-hidden="true">
                  {s.handle}
                </span>
                <span class="dock-name mono" aria-hidden="true">
                  {s.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <footer class="container footer mono">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <a href="#top">back to top ↑</a>
  </footer>
</section>

<style>
  .contact {
    padding-bottom: 32px;
  }

  .cta {
    display: grid;
    gap: 36px;
    justify-items: start;
    margin-bottom: clamp(96px, 14vw, 160px);
  }

  .cta-mail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
  }

  .cta-kicker {
    width: 100%;
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .cta-address {
    position: relative;
    font-size: clamp(1.7rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.035em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    overflow-wrap: anywhere;
  }

  /* ホバーでグラデーションの下線が伸びる */
  .cta-address::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 3px;
    background: var(--grad);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .cta-address:hover::after,
  .cta-address:focus-visible::after {
    transform: scaleX(1);
  }

  .cta-copy {
    padding: 6px 14px;
    font-size: 0.8rem;
    color: var(--ink-2);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .cta-copy:hover,
  .cta-copy:focus-visible {
    color: #fff;
    background: var(--ink);
  }

  .dock {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dock-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    transition:
      color 0.3s,
      background 0.3s,
      border-color 0.3s,
      translate 0.35s cubic-bezier(0.3, 1.6, 0.5, 1),
      box-shadow 0.3s;
  }

  .dock-btn svg {
    width: 26px;
    height: 26px;
  }

  .dock-btn:hover,
  .dock-btn:focus-visible {
    color: #fff;
    background: var(--c);
    border-color: transparent;
    translate: 0 -6px;
    box-shadow: 0 16px 30px -14px var(--c);
  }

  /* アカウント名のツールチップ（ボタンの下に出す） */
  .dock-tip {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    z-index: 1;
    padding: 4px 10px;
    font-size: 0.72rem;
    color: #fff;
    white-space: nowrap;
    background: var(--ink);
    border-radius: 999px;
    opacity: 0;
    translate: -50% -4px;
    pointer-events: none;
    transition:
      opacity 0.2s,
      translate 0.2s;
  }

  .dock-btn:hover .dock-tip,
  .dock-btn:focus-visible .dock-tip {
    opacity: 1;
    translate: -50% 0;
  }

  /* タッチ端末ではツールチップの代わりに、ボタンの下にサービス名を常に表示 */
  .dock-name {
    display: none;
  }

  @media (hover: none) {
    .dock {
      row-gap: 34px;
    }

    .dock-tip {
      display: none;
    }

    .dock-name {
      position: absolute;
      top: calc(100% + 6px);
      left: 50%;
      display: block;
      font-size: 0.7rem;
      color: var(--ink-3);
      white-space: nowrap;
      translate: -50% 0;
    }
  }

  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    font-size: 0.8rem;
    color: var(--ink-3);
    border-top: 1px solid var(--line);
  }

  .footer a:hover {
    color: var(--pink);
  }
</style>
