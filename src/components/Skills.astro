---
import { skills, certifications } from "../data/profile";
import { colorAt } from "../data/palette";
import SkillCard from "./SkillCard.astro";
---

<section class="section" id="skills">
  <div class="container">
    <div class="section-head">
      <span class="section-index">02 /</span>
      <h2 class="section-title">Skills <span class="grad">&amp; Stack</span></h2>
    </div>

    <p class="hint mono">// hover or tap a card</p>
    <div class="skill-grid" data-spotlight data-anim-scope>
      {skills.map((g, i) => <SkillCard label={g.label} items={g.items} c={colorAt(i + 1)} c2={colorAt(i + 3)} />)}
    </div>

    <h3 class="sub-title mono">// certifications</h3>
    <ul class="certs">
      {
        certifications.map((c) => (
          <li class="cert">
            <span class="cert-year mono">{c.year}</span>
            <span class="cert-name">{c.name}</span>
            <span class="cert-issuer mono">{c.issuer}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hint {
    margin: -32px 0 24px;
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 24px;
    margin-bottom: 80px;
  }

  .sub-title {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink-3);
  }

  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cert {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding: 7px 0;
    line-height: 1.6;
  }

  .cert-year {
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .cert-name {
    font-family: var(--font-jp);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink-2);
  }

  .cert-issuer {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  @media (max-width: 560px) {
    .cert {
      grid-template-columns: 44px minmax(0, 1fr);
      column-gap: 10px;
      row-gap: 0;
    }

    .cert-issuer {
      grid-column: 2;
    }
  }
</style>
